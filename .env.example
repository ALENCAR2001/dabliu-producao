# Copie para .env e preencha com os dados do projeto Supabase
# Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica

# Login na nuvem (e-mails: michael@dominio, admin@dominio)
VITE_AUTH_EMAIL_DOMAIN=dabliu.app

# Apenas para scripts de setup — NÃO commitar nem publicar
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# Opcional: script cria tabelas automaticamente (Database → Connection string URI)
# SUPABASE_DB_URL=postgresql://postgres.xxxx:[SENHA]@aws-0-xx.pooler.supabase.com:6543/postgres
